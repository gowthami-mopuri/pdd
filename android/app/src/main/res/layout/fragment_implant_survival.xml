<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundLight"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
             PROCESSING STATE  (visible initially)
             â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <LinearLayout
            android:id="@+id/ll_processing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <!-- Scan thumbnail -->
                    <ImageView
                        android:id="@+id/iv_processing_thumb"
                        android:layout_width="120dp"
                        android:layout_height="90dp"
                        android:scaleType="centerCrop"
                        android:background="#111827"
                        android:visibility="gone"
                        app:cardCornerRadius="8dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Brain / AI Icon -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#2563EB"
                        android:background="@drawable/bg_info_box"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini AI Analysis"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_processing_patient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient"
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="28dp" />

                    <!-- Step list -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/step_row_0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/step_icon_0"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="o"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:textColor="#94A3B8"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:id="@+id/step_text_0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Uploaded image received..."
                                android:textSize="14sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_row_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/step_icon_1"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="o"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:textColor="#94A3B8"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:id="@+id/step_text_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Connecting to Google Gemini 2.5 Vision..."
                                android:textSize="14sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_row_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/step_icon_2"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="o"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:textColor="#94A3B8"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:id="@+id/step_text_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Analyzing medical &amp; anatomical factors..."
                                android:textSize="14sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_row_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/step_icon_3"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="o"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:textColor="#94A3B8"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:id="@+id/step_text_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Running survival probability predictions..."
                                android:textSize="14sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_row_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/step_icon_4"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="o"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:textColor="#94A3B8"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:id="@+id/step_text_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Generating clinical recommendations..."
                                android:textSize="14sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
             RESULTS STATE  (gone initially)
             â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <LinearLayout
            android:id="@+id/ll_survival_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- â”€â”€ 1. Header Banner â”€â”€ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/borderColor"
                android:backgroundTint="#F8FAFC"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#2563EB" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Implant Survival Prediction"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary" />

                        <TextView
                            android:id="@+id/tv_header_patient_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dynamic Gemini AI risk analysis"
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Back button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_back"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="← Back"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:backgroundTint="@android:color/transparent"
                                app:strokeColor="#CBD5E1"
                                app:strokeWidth="1dp"
                                app:cornerRadius="8dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:layout_marginEnd="6dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                            <!-- Save button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_publish_survival"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Save to Reports"
                                android:textSize="11sp"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#059669"
                                app:cornerRadius="8dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:layout_marginEnd="6dp"
                                style="@style/Widget.MaterialComponents.Button" />

                            <!-- Download PDF button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_download_pdf"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Download PDF"
                                android:textSize="11sp"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#1D4ED8"
                                app:cornerRadius="8dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                style="@style/Widget.MaterialComponents.Button" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â”€â”€ 2. Patient Profile â”€â”€ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient Profile"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full Name"
                                android:textSize="10sp"
                                android:textColor="@color/textMuted" />
                            <TextView
                                android:id="@+id/tv_patient_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Patient ID / Demographics"
                                android:textSize="10sp"
                                android:textColor="@color/textMuted" />
                            <TextView
                                android:id="@+id/tv_patient_demographics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medical History"
                                android:textSize="10sp"
                                android:textColor="@color/textMuted" />
                            <TextView
                                android:id="@+id/tv_patient_medical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="None reported"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â”€â”€ 3. Survival Probability + Stats â”€â”€ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <!-- Uploaded scan thumbnail -->
                    <ImageView
                        android:id="@+id/iv_result_scan"
                        android:layout_width="200dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:background="#111827"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Survival Probability"
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="6dp" />

                    <!-- Big probability number -->
                    <TextView
                        android:id="@+id/tv_survival_prob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"
                        android:layout_marginBottom="8dp" />

                    <!-- Risk badge -->
                    <TextView
                        android:id="@+id/tv_risk_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOW RISK"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#16A34A"
                        android:background="@drawable/bg_status_badge"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Failure Risk + Confidence row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_info_box"
                            android:padding="14dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Failure Risk"
                                android:textSize="11sp"
                                android:textColor="#94A3B8" />

                            <TextView
                                android:id="@+id/tv_failure_risk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--%"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#EF4444"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_info_box"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI Confidence"
                                android:textSize="11sp"
                                android:textColor="#94A3B8" />

                            <TextView
                                android:id="@+id/tv_confidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--%"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#2563EB"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â”€â”€ 4. Risk Analysis Breakdown â”€â”€ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Risk Analysis Breakdown"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="16dp" />

                    <!-- Risk factors will be added programmatically below this -->
                    <LinearLayout
                        android:id="@+id/ll_risk_factors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â”€â”€ 5. Clinical Recommendations & AI Narrative (2-column) â”€â”€ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clinical Recommendations &amp; Gemini Narrative"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="16dp" />

                    <!-- Mobile-friendly Vertical Stack layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Action Items Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTION ITEMS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="10dp" />

                        <!-- Action items added programmatically -->
                        <LinearLayout
                            android:id="@+id/ll_action_items"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"
                            android:layout_marginBottom="16dp" />

                        <!-- AI Narrative Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI NARRATIVE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="10dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E2E8F0"
                            android:backgroundTint="#FAFAFA">

                            <TextView
                                android:id="@+id/tv_narrative_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="12sp"
                                android:textColor="#334155"
                                android:lineSpacingMultiplier="1.4"
                                android:padding="14dp" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â”€â”€ 6. Auto-Generated PDF Report Preview â”€â”€ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Generated PDF Report Preview"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="14dp" />

                    <!-- â”€â”€ White inner PDF card (matches web) â”€â”€ -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        android:backgroundTint="@color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- PDF Header row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="14dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Global Dental Clinics"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="#1E293B" />

                                    <TextView
                                        android:id="@+id/tv_pdf_subtitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Implant Survival Analysis Report"
                                        android:textSize="11sp"
                                        android:textColor="#64748B"
                                        android:layout_marginTop="3dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="end">

                                    <TextView
                                        android:id="@+id/tv_pdf_score"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="--% Success"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="#16A34A" />

                                    <TextView
                                        android:id="@+id/tv_pdf_risk"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Risk Level: --"
                                        android:textSize="11sp"
                                        android:textColor="@color/textSecondary"
                                        android:layout_marginTop="3dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/borderColor"
                                android:layout_marginBottom="14dp" />

                            <!-- PDF Body: Vertical stacked full-width layout for mobile legibility -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="14dp">

                                <!-- Risk Factors -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Risk Factors"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:id="@+id/ll_pdf_risk_factors"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="12dp" />

                                <!-- Recommendations -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Recommendations"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:id="@+id/ll_pdf_recommendations"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />

                            </LinearLayout>

                            <!-- PDF Footer -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/borderColor"
                                android:layout_marginBottom="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Generated by Dental AI &amp; Google Gemini"
                                    android:textSize="10sp"
                                    android:textColor="@color/textMuted" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="end">

                                    <View
                                        android:layout_width="80dp"
                                        android:layout_height="1dp"
                                        android:background="@color/borderColor"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Dr. Signature"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/textPrimary"
                                        android:gravity="end" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Attending Physician"
                                        android:textSize="10sp"
                                        android:textColor="@color/textMuted"
                                        android:gravity="end" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- end white inner PDF card -->

                    <!-- Download PDF Action Button below PDF Card -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download_pdf_card"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Download PDF Report"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#1D4ED8"
                        app:cornerRadius="10dp"
                        android:layout_marginTop="16dp"
                        style="@style/Widget.MaterialComponents.Button" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        <!-- end ll_survival_results -->

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
