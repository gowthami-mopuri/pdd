<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_landing_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Login Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/borderColor"
            android:backgroundTint="@color/surfaceLight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Back button link -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btn_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="← Back to Selection"
                        android:textSize="12sp"
                        android:textColor="@color/textPrimary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_glass_panel"
                        android:backgroundTint="@color/backgroundLight"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- User Icon in Circle -->
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_user_outline"
                    android:background="@drawable/bg_glass_panel"
                    android:backgroundTint="@color/backgroundLight"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp" />

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Portal"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Access your personal dental records and AI analysis."
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Error label -->
                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorDanger"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <!-- Patient ID Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient ID"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_patient_id"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="e.g. PT-2024-001"
                        android:textColorHint="@color/textMuted"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_glass_panel"
                        android:backgroundTint="@color/backgroundLight"
                        android:inputType="text"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- Date of Birth Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date of Birth (Optional)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="6dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_glass_panel"
                        android:backgroundTint="@color/backgroundLight"
                        android:paddingHorizontal="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_dob"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/iv_calendar_icon"
                            android:background="@null"
                            android:hint="dd-mm-yyyy"
                            android:textColorHint="@color/textMuted"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none" />

                        <ImageView
                            android:id="@+id/iv_calendar_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            app:tint="@color/textSecondary" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="For verification purposes."
                    android:textSize="12sp"
                    android:textColor="@color/textMuted"
                    android:layout_marginBottom="24dp" />

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Access Portal"
                    style="@style/ButtonPrimary"
                    android:backgroundTint="@color/colorSecondary"
                    android:paddingVertical="12dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
