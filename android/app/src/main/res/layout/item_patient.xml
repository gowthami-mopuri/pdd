<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/borderColor"
    android:backgroundTint="@color/surfaceLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Patient Name & ID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_patient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tv_patient_id"
                android:layout_marginEnd="12dp"
                android:text="Sravanthi"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/tv_patient_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="PT 2024"
                android:textSize="13sp"
                android:textColor="@color/textSecondary" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borderColor"
            android:layout_marginBottom="10dp" />

        <!-- Info Row: Date and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Date Added with Calendar icon -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:tint="@color/textSecondary"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tv_patient_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3/7/2026"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Status Label -->
            <TextView
                android:id="@+id/tv_patient_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultation"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borderColor"
            android:layout_marginBottom="12dp" />

        <!-- Footer: Risk badge & View button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Risk Badge -->
            <TextView
                android:id="@+id/tv_patient_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Pending"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:background="@drawable/bg_glass_panel"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <!-- View Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_profile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="View Profile"
                android:textSize="12sp"
                android:textColor="#3B82F6"
                style="@style/Widget.Material3.Button.TextButton"
                android:paddingHorizontal="8dp"/>
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
